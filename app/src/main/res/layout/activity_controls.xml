<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".ControlsActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="304dp"
        android:layout_height="476dp"
        android:layout_marginEnd="44dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/nextDownButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nextUpButton"
        app:layout_constraintVertical_bias="0.308">

        <com.google.android.material.slider.Slider
            android:id="@+id/slider"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_margin="200dp"
            android:layout_marginTop="200dp"
            android:contentDescription="@string/toggle_opacity"
            android:rotation="270"
            android:scaleX="2"
            android:scaleY="2"
            android:valueFrom="0.0"
            android:valueTo="1.0"
            android:stepSize="0.05"
            app:thumbColor="@color/teal_200"
            app:trackColor="@color/grey" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/nextDownButton"
        android:layout_width="150dp"
        android:layout_height="56dp"
        android:layout_marginStart="121dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="122dp"
        android:background="@drawable/button_background"
        android:gravity="center"
        android:text="@string/next"
        android:textAllCaps="true"
        android:textSize="21sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <TextView
        android:id="@+id/toggle_button_label"
        android:layout_width="85dp"
        android:layout_height="31dp"
        android:layout_marginStart="102dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="44dp"
        android:gravity="center"
        android:text="@string/music"
        android:textColor="@color/teal_700"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/direction_button_label"
        app:layout_constraintTop_toBottomOf="@+id/nextDownButton" />

    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/toggleButton"
        android:layout_width="146dp"
        android:layout_height="55dp"
        android:layout_marginStart="69dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="39dp"
        android:background="@drawable/button_background"
        android:gravity="center"
        android:textSize="21sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/directionButton"
        app:layout_constraintTop_toBottomOf="@+id/toggle_button_label" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/nextUpButton"
        android:layout_width="150dp"
        android:layout_height="56dp"
        android:layout_marginStart="123dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="123dp"
        android:background="@drawable/button_background"
        android:gravity="center"
        android:text="@string/next"
        android:textAllCaps="true"
        android:textSize="21sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/direction_button_label"
        android:layout_width="145dp"
        android:layout_height="32dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="31dp"
        android:gravity="center"
        android:text="@string/direction"
        android:textAllCaps="true"
        android:textColor="@color/teal_700"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextDownButton" />

    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/directionButton"
        android:layout_width="146dp"
        android:layout_height="55dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="39dp"
        android:background="@drawable/button_background"
        android:textOff="@string/right"
        android:textOn="@string/left"
        android:textSize="21sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/direction_button_label" />


</androidx.constraintlayout.widget.ConstraintLayout>
